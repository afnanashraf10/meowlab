# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the same directory as docker-compose.yaml,
# then fill in real values below.
#
#   cp .env.example .env
#
# .env is git-ignored and must NEVER be committed — it holds live credentials.
# =============================================================================

# --- Public domains (used by Traefik routing labels) ------------------------
# Replace with your own domain(s), or a local hostname like jellyfin.home.arpa
# if you're only accessing this over Tailscale/LAN and don't want a public
# domain tied to it at all.
JELLYFIN_DOMAIN=jellyfin.example.com
JELLYSEERR_DOMAIN=jellyseerr.example.com

# --- NordVPN (used by the "gluetun" service) --------------------------------
# These are NordVPN "service credentials", NOT your regular NordVPN email/password.
# Generate them at: https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
NORD_VPN_USERNAME=your_nordvpn_service_username
NORD_VPN_PASSWORD=your_nordvpn_service_password

# --- Tailscale (used by the "tailscale" service) ----------------------------
# Generate an auth key (reusable or ephemeral) at:
# https://login.tailscale.com/admin/settings/keys
TS_TOKEN=your_tailscale_auth_key

# --- Cloudflare Tunnel (used by the "cloudflared" service) ------------------
# Create a tunnel and copy its token from the Cloudflare Zero Trust dashboard:
# https://one.dash.cloudflare.com/ -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
